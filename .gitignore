# 가상 환경
.venv/
venv/
env/

# 빌드 및 배포 관련
build/
dist/
*.spec
# Pucro.spec은 빌드 지침(AGENTS.md)이 기준으로 삼는 파일이라 추적한다.
# (hiddenimports 등 배포에 필요한 설정이 들어 있어 제외하면 커밋에 반영되지 않는다)
!Pucro.spec

# 파이참 관련
.idea/
*.iml

# 기타 파이썬 관련 파일
__pycache__/
*.pyc
.pytest_cache/

# 운영체제 관련 파일
.DS_Store
Thumbs.db

# 설정 파일 (로컬 전용)
pucro_config.json